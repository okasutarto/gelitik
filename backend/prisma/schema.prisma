generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String?
  avatar    String?
  password  String?
  googleId  String?         @unique
  githubId  String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessions  Session[]
  accounts  SocialAccount[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id                 String      @id @default(cuid())
  userId             String
  platform           String
  accountId          String
  displayName        String
  username           String?
  avatar             String?
  accessToken        String?     // Deprecated: use accessTokenEncrypted
  accessTokenEncrypted String?   // AES-256-GCM encrypted access token
  refreshToken       String?     // Deprecated: use refreshTokenEncrypted
  refreshTokenEncrypted String?  // AES-256-GCM encrypted refresh token
  expiresAt          DateTime?
  tokenType          String?
  scope              String?
  isActive           Boolean     @default(true)
  metadata           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  analytics          Analytics[]
  content            Content[]
  posts              Post[]
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
}

model Analytics {
  id              String        @id @default(cuid())
  accountId       String
  date            DateTime      @default(now())
  followers       Int           @default(0)
  following       Int           @default(0)
  totalLikes      Int           @default(0)
  totalComments   Int           @default(0)
  totalShares     Int           @default(0)
  totalViews      Int           @default(0)
  engagementRate  Float         @default(0)
  platformMetrics Json?
  createdAt       DateTime      @default(now())
  account         SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}

model Content {
  id          String        @id @default(cuid())
  accountId   String
  contentId   String
  type        String
  title       String?
  description String?
  thumbnail   String?
  url         String?
  videoUrl    String?
  likes       Int           @default(0)
  comments    Int           @default(0)
  shares      Int           @default(0)
  views       Int           @default(0)
  saves       Int           @default(0)
  reach       Int           @default(0)
  impressions Int           @default(0)
  duration    Int?
  postedAt    DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, contentId])
}

model Post {
  id           String        @id @default(cuid())
  accountId    String
  title        String?
  caption      String?
  mediaUrls    String[]
  scheduledFor DateTime
  status       String
  platform     String
  publishedId  String?
  publishedUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  platform  String
  expiresAt DateTime
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

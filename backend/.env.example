# Environment Variables
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/gelitik_db"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Encryption Key (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# TikTok API
TIKTOK_CLIENT_ID="your-tiktok-client-id"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="https://your-domain.ngrok-free.dev/auth/tiktok/callback"

# Instagram API (Basic Display API)
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/auth/instagram/callback"

# Instagram Graph API (for business insights)
# Requires Instagram Business account linked to Facebook Page
INSTAGRAM_GRAPH_APP_ID="your-instagram-graph-app-id"
INSTAGRAM_GRAPH_APP_SECRET="your-instagram-graph-app-secret"
INSTAGRAM_GRAPH_REDIRECT_URI="http://localhost:3000/auth/instagram-graph/callback"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Redis (for caching, optional)
REDIS_URL="redis://localhost:6379"